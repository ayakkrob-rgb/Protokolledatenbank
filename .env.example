# Kopiere diese Datei nach ".env" und passe die Werte an.

# Langer, zufälliger Schlüssel (z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=bitte-aendern

# Nur lokal zum Entwickeln auf 1 setzen, im Betrieb immer 0
DEBUG=0

# Öffentliche Adresse der Webseite (ohne / am Ende). Wird für Links in E-Mails
# und für die Rückleitung von Stripe benötigt.
SITE_URL=https://protokolle.example.org

# Optional: weitere Hostnamen (kommagetrennt). Der Host aus SITE_URL ist immer erlaubt.
# ALLOWED_HOSTS=protokolle.example.org,www.protokolle.example.org

# Speicherort für Datenbank und hochgeladene Dateien
DATA_DIR=./data

# Läuft die Seite hinter einem Reverse-Proxy (nginx, Caddy, Traefik), der HTTPS terminiert?
BEHIND_PROXY=1

# Optional: HTTPS erzwingen bzw. HSTS aktivieren (meist übernimmt das der Reverse-Proxy)
# SECURE_SSL_REDIRECT=1
# HSTS_SECONDS=31536000

# Erstes Admin-Konto (wird beim Start angelegt, falls es noch nicht existiert)
ADMIN_EMAIL=admin@uni-beispiel.de
ADMIN_PASSWORD=bitte-ein-sicheres-passwort

# Beispieldaten (Testprüfer & Testprotokolle) beim Start anlegen? 1 = ja
DEMO_DATA=1

# --- Optional: Geheimnisse statt im Adminbereich als Umgebungsvariable setzen ---
# Ist eine Variable gesetzt, hat sie Vorrang vor dem Wert im Adminbereich.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SMTP_PASSWORD=...

# --- Optional: PostgreSQL statt SQLite (benötigt "psycopg[binary]") ---
# POSTGRES_DB=protokolle
# POSTGRES_USER=protokolle
# POSTGRES_PASSWORD=...
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
